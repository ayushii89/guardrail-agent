# Required for running the agent and the evaluation suite (not for unit tests).
ANTHROPIC_API_KEY=sk-ant-...

# Set to 1 to run everything with deterministic canned responses and zero API
# spend (demos, local dev, CI). Answers are built from the retrieved fixtures;
# guardrail/judge verdicts are heuristics, not a real model.
# GUARDRAIL_OFFLINE=1

# Optional model overrides.
GUARDRAIL_AGENT_MODEL=claude-opus-5
GUARDRAIL_GUARD_MODEL=claude-sonnet-5
GUARDRAIL_JUDGE_MODEL=claude-sonnet-5

# Optional: a real Notion integration token (internal integration).
# When set, the "notion" connector queries the live Notion API instead of the
# local fixture. Create one at https://www.notion.so/my-integrations and share
# the pages/databases you want searchable with the integration.
# NOTION_API_KEY=ntn_...

# Optional: real Jira Cloud credentials. All three required to go live; the
# "jira" connector runs a JQL text search. Token: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://yoursite.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=...

