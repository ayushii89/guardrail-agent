# Required for running the agent and the evaluation suite (not for unit tests).
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides.
GUARDRAIL_AGENT_MODEL=claude-opus-5
GUARDRAIL_GUARD_MODEL=claude-sonnet-5
GUARDRAIL_JUDGE_MODEL=claude-sonnet-5

# Optional: a real Notion integration token (internal integration).
# When set, the "notion" connector queries the live Notion API instead of the
# local fixture. Create one at https://www.notion.so/my-integrations and share
# the pages/databases you want searchable with the integration.
# NOTION_API_KEY=ntn_...

